# Preserve frozen source/evidence bytes across add and clone on all platforms.
# Disabling EOL conversion does not disable normal text diffs.
* -text
# Store large model and deployable artifacts using Git LFS when publishing.
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.bit filter=lfs diff=lfs merge=lfs -text
*.xsa filter=lfs diff=lfs merge=lfs -text
*.ub filter=lfs diff=lfs merge=lfs -text
*.ko filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.aipkg filter=lfs diff=lfs merge=lfs -text
*.wdb filter=lfs diff=lfs merge=lfs -text


# Project reports.
*.pdf filter=lfs diff=lfs merge=lfs -text
