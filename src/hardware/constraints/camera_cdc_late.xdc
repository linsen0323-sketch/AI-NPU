# Camera 720p post-synthesis CDC constraints - STATIC XDC commands only.
# Used in implementation ONLY, processing order LATE.
# Do not mask entire clock groups. Video, AXI, DVP paths remain checked.
# Only FIRST synchronizer D pins are false-pathed; downstream sync flops remain timed.

set_false_path -to [get_pins -quiet {sensor_status_meta_reg[0]/D sensor_status_meta_reg[1]/D sensor_status_meta_reg[2]/D sensor_status_meta_reg[3]/D}]
set_false_path -to [get_pins -quiet {video_status_meta_reg[0]/D video_status_meta_reg[1]/D}]
set_false_path -to [get_pins -quiet {u_capture/status_meta_reg[0]/D u_capture/status_meta_reg[1]/D u_capture/status_meta_reg[2]/D u_capture/status_meta_reg[3]/D u_capture/status_meta_reg[4]/D u_capture/status_meta_reg[5]/D}]
set_false_path -to [get_pins -quiet {u_capture/error_meta_reg[0]/D u_capture/error_meta_reg[1]/D u_capture/error_meta_reg[2]/D u_capture/error_meta_reg[3]/D}]
set_false_path -to [get_pins -quiet {u_capture/ready_meta_sync_reg[0]/D}]
set_false_path -to [get_pins -quiet {u_capture/enable_cam_sync_reg[0]/D}]
set_false_path -to [get_pins -quiet {display_enable_sync_reg[0]/D}]

# Bound THREE registered Gray counter buses; NO false_path on these data pins.
# Keep first-stage Gray inter-bit skew physically limited (< 10ns AXI clock).

