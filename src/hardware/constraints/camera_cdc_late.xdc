# Recovery/removal check is excluded ONLY at the two async CLR pins of each
# asynchronously asserted / synchronously deasserted cam_pclk reset synchronizer.
# All downstream resets and sync-stage D paths remain timed.
set_false_path -to [get_pins -quiet {u_capture/stream_cam_sync_reg[0]/CLR u_capture/stream_cam_sync_reg[1]/CLR}]
set_false_path -to [get_pins -quiet {u_capture/reset_cam_sync_reg[0]/CLR u_capture/reset_cam_sync_reg[1]/CLR}]
